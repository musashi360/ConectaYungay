{"nodes": [{"id": "index_page", "label": "Conecta Yungay \u2014 index.html", "file_type": "code", "source_file": "index.html", "source_location": "L1-254", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "index_content_security_policy", "label": "Content Security Policy (CSP)", "file_type": "rationale", "source_file": "index.html", "source_location": "L20-42", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CSP restricts external resources to only what the app needs (unpkg.com for Leaflet, cdnjs.cloudflare.com for html2canvas, Google Fonts domains, OpenStreetMap tile domains, and the Supabase endpoint via connect-src). Blocks inline scripts, other-origin scripts, objects and iframes. 'unsafe-inline' is kept only for style-src because Leaflet applies inline styles via JS. frame-ancestors (anti-clickjacking) cannot be set via <meta>, so on GitHub Pages (no custom HTTP headers available) that protection is limited."}, {"id": "index_https_enforcement", "label": "HTTPS Enforcement (httpsRedirect.js)", "file_type": "rationale", "source_file": "index.html", "source_location": "L17-18", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "HTTPS redirect is implemented as an external script file rather than inline specifically so the CSP's script-src does not need to allow 'unsafe-inline'."}, {"id": "index_referrer_policy", "label": "Referrer Policy (strict-origin-when-cross-origin)", "file_type": "rationale", "source_file": "index.html", "source_location": "L44-45", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Avoids sending the full URL to external sites when a user clicks an outbound link, limiting referrer leakage."}, {"id": "index_sri_resource_integrity", "label": "Subresource Integrity (SRI)", "file_type": "rationale", "source_file": "index.html", "source_location": "L47-60", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Integrity hashes on the Leaflet CSS/JS and html2canvas CDN assets make the browser reject the file if the CDN-served content is altered or tampered with."}, {"id": "index_layered_architecture", "label": "N-Layer Architecture (Security \u2192 Data \u2192 Business \u2192 Presentation)", "file_type": "rationale", "source_file": "index.html", "source_location": "L238-251", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scripts are loaded in a strict dependency order: security utilities first because other modules depend on Security.escapeHTML, then data-layer modules, then business-layer services, then presentation-layer renderers/controllers."}, {"id": "index_survey_screen", "label": "Visitor Survey Screen (Cu\u00e9ntanos de tu Visita)", "file_type": "concept", "source_file": "index.html", "source_location": "L78-149", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "index_welcome_screen", "label": "Welcome Screen (Pasaporte Patrimonial)", "file_type": "concept", "source_file": "index.html", "source_location": "L151-173", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "index_app_screen", "label": "Main App Screen", "file_type": "concept", "source_file": "index.html", "source_location": "L175-234", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "index_route_card", "label": "Tu Ruta (Route Panel)", "file_type": "concept", "source_file": "index.html", "source_location": "L205-208", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "index_discounts_card", "label": "Tus Beneficios (Discounts Panel)", "file_type": "concept", "source_file": "index.html", "source_location": "L211-227", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "index_map_card", "label": "Interactive Map Panel",